node_modules/
.next/
.data/
next-env.d.ts
*.tsbuildinfo
.env*.local

# personal, per-machine Claude Code settings
.claude/settings.local.json
CLAUDE.md

# Source archives for the mushaf fonts. Everything the app uses is extracted
# into public/fonts; these are only the downloads it came from.
data/*.zip
data/*.bz2

# ASR spike: cached model weights and audio, and results from your own voice
# recordings, which stay on your machine.
scripts/asr-spike/.cache/
scripts/asr-spike/results-own.json

# Skylos: the reviewed baseline is committed as .skylos/baseline.portable.json,
# with repo-relative paths. Skylos itself only reads .skylos/baseline.json,
# which holds this checkout's absolute paths and is rebuilt by
# scripts/skylos-baseline.mjs. Its lookup cache is rebuilt on every scan.
.skylos/cache/
.skylos/baseline.json

# Playwright: the end-to-end build, its reports and failure artifacts.
.next-e2e/
test-results/
playwright-report/
blob-report/
