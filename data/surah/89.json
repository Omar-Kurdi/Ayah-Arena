َوْنَ ذِى ٱلْأَوْتَادِ","imlaei":"وَفِرْعَوْنَ ذِي الْأَوْتَادِ","simple":"وفرعون ذي الاوتاد","page":593,"juz":30},{"key":"89:11","surah":89,"ayah":11,"uthmani":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ","imlaei":"الَّذِينَ طَغَوْا فِي الْبِلَادِ","simple":"الذين طغوا في البلاد","page":593,"juz":30},{"key":"89:12","surah":89,"ayah":12,"uthmani":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","imlaei":"فَأَكْثَرُوا فِيهَا الْفَسَادَ","simple":"فاكثروا فيها الفساد","page":593,"juz":30},{"key":"89:13","surah":89,"ayah":13,"uthmani":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","imlaei":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","simple":"فصب عليهم ربك سوط عذاب","page":593,"juz":30},{"key":"89:14","surah":89,"ayah":14,"uthmani":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","imlaei":"إِنَّ رَبَّكَ لَبِالْمِرْصَادِ","simple":"ان ربك لبالمرصاد","page":593,"juz":30},{"key":"89:15","surah":89,"ayah":15,"uthmani":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","imlaei":"فَأَمَّا الْإِنسَانُ إِذَا مَا ابْتَلَاهُ رَبُّهُ فَأَكْرَمَهُ وَنَعَّمَهُ فَيَقُولُ رَبِّي أَكْرَمَنِ","simple":"فاما الانسان اذا ما ابتلاه ربه فاكرمه ونعمه فيقول ربي اكرمن","page":593,"juz":30},{"key":"89:16","surah":89,"ayah":16,"uthmani":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ","imlaei":"وَأَمَّا إِذَا مَا ابْتَلَاهُ فَقَدَرَ عَلَيْهِ رِزْقَهُ فَيَقُولُ رَبِّي أَهَانَنِ","simple":"واما اذا ما ابتلاه فقدر عليه رزقه فيقول ربي اهانن","page":593,"juz":30},{"key":"89:17","surah":89,"ayah":17,"uthmani":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","imlaei":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ الْيَتِيمَ","simple":"كلا بل لا تكرمون اليتيم","page":593,"juz":30},{"key":"89:18","surah":89,"ayah":18,"uthmani":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","imlaei":"وَلَا تَحَاضُّونَ عَلَىٰ طَعَامِ الْمِسْكِينِ","simple":"ولا تحاضون على طعام المسكين","page":593,"juz":30},{"key":"89:19","surah":89,"ayah":19,"uthmani":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْ