ُوا لِيَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ وَيَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا ۙ وَلَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ ۙ وَلِيَقُولَ الَّذِينَ فِي قُلُوبِهِم مَّرَضٌ وَالْكَافِرُونَ مَاذَا أَرَادَ اللَّهُ بِهَٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ اللَّهُ مَن يَشَاءُ وَيَهْدِي مَن يَشَاءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِيَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","simple":"وما جعلنا اصحاب النار الا ملائكة وما جعلنا عدتهم الا فتنة للذين كفروا ليستيقن الذين اوتوا الكتاب ويزداد الذين امنوا ايمانا ولا يرتاب الذين اوتوا الكتاب والمؤمنون وليقول الذين في قلوبهم مرض والكافرون ماذا اراد الله بهذا مثلا كذلك يضل الله من يشاء ويهدي من يشاء وما يعلم جنود ربك الا هو وما هي الا ذكرى للبشر","page":576,"juz":29,"glyphs":[{"p":576,"c":"ﱶ"},{"p":576,"c":"ﱷ"},{"p":576,"c":"ﱸ"},{"p":576,"c":"ﱹ"},{"p":576,"c":"ﱺ"},{"p":576,"c":"ﱻﱼ"},{"p":576,"c":"ﱽ"},{"p":576,"c":"ﱾ"},{"p":576,"c":"ﱿ"},{"p":576,"c":"ﲀ"},{"p":576,"c":"ﲁ"},{"p":576,"c":"ﲂ"},{"p":576,"c":"ﲃ"},{"p":576,"c":"ﲄ"},{"p":576,"c":"ﲅ"},{"p":576,"c":"ﲆ"},{"p":576,"c":"ﲇ"},{"p":576,"c":"ﲈ"},{"p":576,"c":"ﲉ"},{"p":576,"c":"ﲊ"},{"p":576,"c":"ﲋ"},{"p":576,"c":"ﲌ"},{"p":576,"c":"ﲍ"},{"p":576,"c":"ﲎ"},{"p":576,"c":"ﲏ"},{"p":576,"c":"ﲐ"},{"p":576,"c":"ﲑ"},{"p":576,"c":"ﲒ"},{"p":576,"c":"ﲓ"},{"p":576,"c":"ﲔ"},{"p":576,"c":"ﲕ"},{"p":576,"c":"ﲖ"},{"p":576,"c":"ﲗ"},{"p":576,"c":"ﲘ"},{"p":576,"c":"ﲙ"},{"p":576,"c":"ﲚ"},{"p":576,"c":"ﲛ"},{"p":576,"c":"ﲜﲝ"},{"p":576,"c":"ﲞ"},{"p":576,"c":"ﲟ"},{"p":576,"c":"ﲠ"},{"p":576,"c":"ﲡ"},{"p":576,"c":"ﲢ"},{"p":576,"c":"ﲣ"},{"p":576,"c":"ﲤ"},{"p":576,"c":"ﲥﲦ"},{"p":576,"c":"ﲧ"},{"p":576,"c":"ﲨ"},{"p":576,"c":"ﲩ"},{"p":576,"c":"ﲪ"},{"p":576,"c":"ﲫ"},{"p":576,"c":"ﲬﲭ"},{"p":576,"c":"ﲮ"},{"p":576,"c":"ﲯ"},{"p":576,"c":"ﲰ"},{"p":576,"c":"ﲱ"},{"p":576,"c":"ﲲ"}]},{"key":"74:32","surah":74,"ayah":32,"uthmani":"كَلَّا وَٱلْقَمَرِ","imlaei":"كَلَّا وَالْقَمَرِ","simple":"كلا والقمر","page":576,"juz":29,"glyphs":[{"p":576,"c":"ﲴ"},{"p":576,"c":"ﲵ"}]},{"key":"74:33","surah":74,"aya