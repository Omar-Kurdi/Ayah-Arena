ۚ كُلَّ يَوْمٍ هُوَ فِي شَأْنٍ","simple":"يساله من في السماوات والارض كل يوم هو في شان","page":532,"juz":27},{"key":"55:30","surah":55,"ayah":30,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:31","surah":55,"ayah":31,"uthmani":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","imlaei":"سَنَفْرُغُ لَكُمْ أَيُّهَ الثَّقَلَانِ","simple":"سنفرغ لكم ايه الثقلان","page":532,"juz":27},{"key":"55:32","surah":55,"ayah":32,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:33","surah":55,"ayah":33,"uthmani":"يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ","imlaei":"يَا مَعْشَرَ الْجِنِّ وَالْإِنسِ إِنِ اسْتَطَعْتُمْ أَن تَنفُذُوا مِنْ أَقْطَارِ السَّمَاوَاتِ وَالْأَرْضِ فَانفُذُوا ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَانٍ","simple":"يا معشر الجن والانس ان استطعتم ان تنفذوا من اقطار السماوات والارض فانفذوا لا تنفذون الا بسلطان","page":532,"juz":27},{"key":"55:34","surah":55,"ayah":34,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:35","surah":55,"ayah":35,"uthmani":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","imlaei":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","simple":"يرسل عليكما شواظ من نار ونحاس فلا تنتصران","page":532,"juz":27},{"key":"55:36","surah":55,"ayah":36,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:37","surah":55,"ayah":37,"uthmani":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ","imlaei":"فَإِذَا انشَقَّتِ السَّمَاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ","simple":"فاذا انشقت السماء فكانت وردة كالدهان","page":532,"juz":27},{"key":"55:38","surah":55,"ayah":38,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:39","surah":55,"ayah":39,"uthmani":"فَيَوْمَئِذٍ لَّا يُسْـَٔلُ عَن ذَنۢبِهِۦٓ إِنسٌ وَلَا جَآنٌّ","imlaei":"فَيَوْمَئِذٍ لَّا يُسْأَلُ عَن ذَنبِهِ إِنسٌ وَلَا جَانٌّ","simple":"فيومئذ لا يسال عن ذنبه انس ولا جان","page":532,"juz":27},{"key":"55:40","surah":55,"ayah":40,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":532,"juz":27},{"key":"55:41","surah":55,"ayah":41,"uthmani":"يُعْرَفُ ٱلْمُجْرِمُونَ بِسِيمَـٰهُمْ فَيُؤْخَذُ بِٱلنَّوَٰصِى وَٱلْأَقْدَامِ","imlaei":"يُعْرَفُ الْمُجْرِمُونَ بِسِيمَاهُمْ فَيُؤْخَذُ بِالنَّوَاصِي وَالْأَقْدَامِ","simple":"يعرف المجرمون بسيماهم فيؤخذ بالنواصي والاقدام","page":533,"juz":27},{"key":"55:42","surah":55,"ayah":42,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":533,"juz":27},{"key":"55:43","surah":55,"ayah":43,"uthmani":"هَـٰذِهِۦ جَهَنَّمُ ٱلَّتِى يُكَذِّبُ بِهَا ٱلْمُجْرِمُونَ","imlaei":"هَٰذِهِ جَهَنَّمُ الَّتِي يُكَذِّبُ بِهَا الْمُجْرِمُونَ","simple":"هذه جهنم التي يكذب بها المجرمون","page":533,"juz":27},{"key":"55:44","surah":55,"ayah":44,"uthmani":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ ءَانٍ","imlaei":"يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَمِيمٍ آنٍ","simple":"يطوفون بينها وبين حميم ان","page":533,"juz":27},{"key":"55:45","surah":55,"ayah":45,"uthmani":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","imlaei":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","simple":"فباي الاء ربكما تكذبان","page":533,"juz":27},{"key":"55:46","surah":55,"ayah":46,"uthmani":"وَلِمَنْ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","imlaei":"وَلِ