{"surah":37,"fetchedAt":"2026-08-16T09:48:43.092Z","source":{"name":"Quran.com API v4","url":"https://api.quran.com/api/v4","scriptEdition":"Uthmani (Tanzil / King Fahd Complex, via Quran.com)","attribution":"Quran text via Quran.com (Tanzil.net Uthmani edition)"},"meta":{"id":37,"nameArabic":"الصافات","nameSimple":"As-Saffat","nameEnglish":"Those who set the Ranks","versesCount":182,"revelationPlace":"makkah"},"verseCount":182,"verses":[{"key":"37:1","surah":37,"ayah":1,"uthmani":"وَٱلصَّـٰٓفَّـٰتِ صَفًّا","imlaei":"وَالصَّافَّاتِ صَفًّا","simple":"والصافات صفا","page":446,"juz":23},{"key":"37:2","surah":37,"ayah":2,"uthmani":"فَٱلزَّٰجِرَٰتِ زَجْرًا","imlaei":"فَالزَّاجِرَاتِ زَجْرًا","simple":"فالزاجرات زجرا","page":446,"juz":23},{"key":"37:3","surah":37,"ayah":3,"uthmani":"فَٱلتَّـٰلِيَـٰتِ ذِكْرًا","imlaei":"فَالتَّالِيَاتِ ذِكْرًا","simple":"فالتاليات ذكرا","page":446,"juz":23},{"key":"37:4","surah":37,"ayah":4,"uthmani":"إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ","imlaei":"إِنَّ إِلَٰهَكُمْ لَوَاحِدٌ","simple":"ان الهكم لواحد","page":446,"juz":23},{"key":"37:5","surah":37,"ayah":5,"uthmani":"رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ","imlaei":"رَّبُّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ","simple":"رب السماوات والارض وما بينهما ورب المشارق","page":446,"juz":23},{"key":"37:6","surah":37,"ayah":6,"uthmani":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ","imlaei":"إِنَّا زَيَّنَّا السَّمَاءَ الدُّنْيَا بِزِينَةٍ الْكَوَاكِبِ","simple":"انا زينا السماء الدنيا بزينة الكواكب","page":446,"juz":23},{"key":"37:7","surah":37,"ayah":7,"uthmani":"وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ","imlaei":"وَحِفْظًا مِّن كُلِّ شَيْطَانٍ مَّارِدٍ","simple":"وحفظا من كل شيطان مارد","page":446,"juz":23},{"key":"37:8","surah":37,"ayah":8,"uthmani":"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","imlaei":"لَّا يَسَّمَّعُونَ إِلَى الْمَلَإِ الْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ","simple":"لا يسمعون الى الملا الاعلى ويقذفون من كل جانب","page":446,"juz":23},{"key":"37:9","surah":37,"ayah":9,"uthmani":"دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ","imlaei":"دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ","simple":"دحورا ولهم عذاب واصب","page":446,"juz":23},{"key":"37:10","surah":37,"ayah":10,"uthmani":"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ","imlaei":"إِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ","simple":"الا من خطف الخطفة فاتبعه شهاب ثاقب","page":446,"juz":23},{"key":"37:11","surah":37,"ayah":11,"uthmani":"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ","imlaei":"فَاسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَا ۚ إِنَّا خَلَقْنَاهُم مِّن طِينٍ لَّازِبٍ","simple":"فاستفتهم اهم اشد خلقا ام من خلقنا انا خلقناهم من طين لازب","page":446,"juz":23},{"key":"37:12","surah":37,"ayah":12,"uthmani":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","imlaei":"بَلْ عَجِبْتَ وَيَسْخَرُونَ","simple":"بل عجبت ويسخرون","page":446,"juz":23},{"key":"37:13","surah":37,"ayah":13,"uthmani":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","imlaei":"وَإِذَا ذُكِّرُوا لَا يَذْكُرُونَ","simple":"واذا ذكروا لا يذكرون","page":446,"juz":23},{"key":"37:14","surah":37,"ayah":14,"uthmani":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ","imlaei":"وَإِذَا رَأَوْا آيَةً يَسْتَسْخِرُونَ","simple":"واذا راوا اية يستسخرون","page":446,"juz":23},{"key":"37:15","surah":37,"ayah":15,"uthmani":"وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","imlaei":"وَقَالُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُّبِينٌ","simple":"وقالوا ان هذا الا سحر مبين","page":446,"juz":23},{"key":"37:16","surah":37,"ayah":16,"uthmani":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","imlaei":"أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَبْعُوثُونَ","simple":"ااذا متنا وكنا ترابا وعظاما اانا لمبعوثون","page":446,"juz":23},{"key":"37:17","surah":37,"ayah":17,"uthmani":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","imlaei":"أَوَآبَاؤُنَا الْأَوَّلُونَ","simple":"اواباؤنا الاولون","page":446,"juz":23},{"key":"37:18","surah":37,"ayah":18,"uthmani":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","imlaei":"قُلْ نَعَمْ وَأَنتُمْ دَاخِرُونَ","simple":"قل نعم وانتم داخرون","page":446,"juz":23},{"key":"37:19","surah":37,"ayah":19,"uthmani":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","imlaei":"فَإِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","simple":"فانما هي زجرة واحدة فاذا هم ينظرون","page":446,"juz":23},{"key":"37:20","surah":37,"ayah":20,"uthmani":"وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ","imlaei":"وَقَالُوا يَا وَيْلَنَا هَٰذَا يَوْمُ الدِّينِ","simple":"وقالوا يا ويلنا هذا يوم الدين","page":446,"juz":23},{"key":"37:21","surah":37,"ayah":21,"uthmani":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","imlaei":"هَٰذَا يَوْمُ الْفَصْلِ الَّذِي كُنتُم بِهِ تُكَذِّبُونَ","simple":"هذا يوم الفصل الذي كنتم به تكذبون","page":446,"juz":23},{"key":"37:22","surah":37,"ayah":22,"uthmani":"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","imlaei":"احْشُرُوا الَّذِينَ ظَلَمُوا وَأَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَ","simple":"احشروا الذين ظلموا وازواجهم وما كانوا يعبدون","page":446,"juz":23},{"key":"37:23","surah":37,"ayah":23,"uthmani":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","imlaei":"مِن دُونِ اللَّهِ فَاهْدُوهُمْ إِلَىٰ صِرَاطِ الْجَحِيمِ","simple":"من دون الله فاهدوهم الى صراط الجحيم","page":446,"juz":23},{"key":"37:24","surah":37,"ayah":24,"uthmani":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ","imlaei":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْئُولُونَ","simple":"وقفوهم انهم مسئولون","page":446,"juz":23},{"key":"37:25","surah":37,"ayah":25,"uthmani":"مَا لَكُمْ لَا تَنَاصَرُونَ","imlaei":"مَا لَكُمْ لَا تَنَاصَرُونَ","simple":"ما لكم لا تناصرون","page":447,"juz":23},{"key":"37:26","surah":37,"ayah":26,"uthmani":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","imlaei":"بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ","simple":"بل هم اليوم مستسلمون","page":447,"juz":23},{"key":"37:27","surah":37,"ayah":27,"uthmani":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","imlaei":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ","simple":"واقبل بعضهم على بعض يتساءلون","page":447,"juz":23},{"key":"37:28","surah":37,"ayah":28,"uthmani":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","imlaei":"قَالُوا إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ الْيَمِينِ","simple":"قالوا انكم كنتم تاتوننا عن اليمين","page":447,"juz":23},{"key":"37:29","surah":37,"ayah":29,"uthmani":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","imlaei":"قَالُوا بَل لَّمْ تَكُونُوا مُؤْمِنِينَ","simple":"قالوا بل لم تكونوا مؤمنين","page":447,"juz":23},{"key":"37:30","surah":37,"ayah":30,"uthmani":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ","imlaei":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَانٍ ۖ بَلْ كُنتُمْ قَوْمًا طَاغِينَ","simple":"وما كان لنا عليكم من سلطان بل كنتم قوما طاغين","page":447,"juz":23},{"key":"37:31","surah":37,"ayah":31,"uthmani":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","imlaei":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا ۖ إِنَّا لَذَائِقُونَ","simple":"فحق علينا قول ربنا انا لذائقون","page":447,"juz":23},{"key":"37:32","surah":37,"ayah":32,"uthmani":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ","imlaei":"فَأَغْوَيْنَاكُمْ إِنَّا كُنَّا غَاوِينَ","simple":"فاغويناكم انا كنا غاوين","page":447,"juz":23},{"key":"37:33","surah":37,"ayah":33,"uthmani":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","imlaei":"فَإِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ","simple":"فانهم يومئذ في العذاب مشتركون","page":447,"juz":23},{"key":"37:34","surah":37,"ayah":34,"uthmani":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","imlaei":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَ","simple":"انا كذلك نفعل بالمجرمين","page":447,"juz":23},{"key":"37:35","surah":37,"ayah":35,"uthmani":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","imlaei":"إِنَّهُمْ كَانُوا إِذَا قِيلَ لَهُمْ لَا إِلَٰهَ إِلَّا اللَّهُ يَسْتَكْبِرُونَ","simple":"انهم كانوا اذا قيل لهم لا اله الا الله يستكبرون","page":447,"juz":23},{"key":"37:36","surah":37,"ayah":36,"uthmani":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ","imlaei":"وَيَقُولُونَ أَئِنَّا لَتَارِكُو آلِهَتِنَا لِشَاعِرٍ مَّجْنُونٍ","simple":"ويقولون ائنا لتاركو الهتنا لشاعر مجنون","page":447,"juz":23},{"key":"37:37","surah":37,"ayah":37,"uthmani":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","imlaei":"بَلْ جَاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِينَ","simple":"بل جاء بالحق وصدق المرسلين","page":447,"juz":23},{"key":"37:38","surah":37,"ayah":38,"uthmani":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","imlaei":"إِنَّكُمْ لَذَائِقُو الْعَذَابِ الْأَلِيمِ","simple":"انكم لذائقو العذاب الاليم","page":447,"juz":23},{"key":"37:39","surah":37,"ayah":39,"uthmani":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","imlaei":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","simple":"وما تجزون الا ما كنتم تعملون","page":447,"juz":23},{"key":"37:40","surah":37,"ayah":40,"uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","imlaei":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ","simple":"الا عباد الله المخلصين","page":447,"juz":23},{"key":"37:41","surah":37,"ayah":41,"uthmani":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","imlaei":"أُولَٰئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","simple":"اولئك لهم رزق معلوم","page":447,"juz":23},{"key":"37:42","surah":37,"ayah":42,"uthmani":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","imlaei":"فَوَاكِهُ ۖ وَهُم مُّكْرَمُونَ","simple":"فواكه وهم مكرمون","page":447,"juz":23},{"key":"37:43","surah":37,"ayah":43,"uthmani":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","imlaei":"فِي جَنَّاتِ النَّعِيمِ","simple":"في جنات النعيم","page":447,"juz":23},{"key":"37:44","surah":37,"ayah":44,"uthmani":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ","imlaei":"عَلَىٰ سُرُرٍ مُّتَقَابِلِينَ","simple":"على سرر متقابلين","page":447,"juz":23},{"key":"37:45","surah":37,"ayah":45,"uthmani":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ","imlaei":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍ","simple":"يطاف عليهم بكاس من معين","page":447,"juz":23},{"key":"37:46","surah":37,"ayah":46,"uthmani":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ","imlaei":"بَيْضَاءَ لَذَّةٍ لِّلشَّارِبِينَ","simple":"بيضاء لذة للشاربين","page":447,"juz":23},{"key":"37:47","surah":37,"ayah":47,"uthmani":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","imlaei":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","simple":"لا فيها غول ولا هم عنها ينزفون","page":447,"juz":23},{"key":"37:48","surah":37,"ayah":48,"uthmani":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","imlaei":"وَعِندَهُمْ قَاصِرَاتُ الطَّرْفِ عِينٌ","simple":"وعندهم قاصرات الطرف عين","page":447,"juz":23},{"key":"37:49","surah":37,"ayah":49,"uthmani":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","imlaei":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","simple":"كانهن بيض مكنون","page":447,"juz":23},{"key":"37:50","surah":37,"ayah":50,"uthmani":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","imlaei":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ","simple":"فاقبل بعضهم على بعض يتساءلون","page":447,"juz":23},{"key":"37:51","surah":37,"ayah":51,"uthmani":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ","imlaei":"قَالَ قَائِلٌ مِّنْهُمْ إِنِّي كَانَ لِي قَرِينٌ","simple":"قال قائل منهم اني كان لي قرين","page":447,"juz":23},{"key":"37:52","surah":37,"ayah":52,"uthmani":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","imlaei":"يَقُولُ أَإِنَّكَ لَمِنَ الْمُصَدِّقِينَ","simple":"يقول اانك لمن المصدقين","page":448,"juz":23},{"key":"37:53","surah":37,"ayah":53,"uthmani":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ","imlaei":"أَإِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا أَإِنَّا لَمَدِينُونَ","simple":"ااذا متنا وكنا ترابا وعظاما اانا لمدينون","page":448,"juz":23},{"key":"37:54","surah":37,"ayah":54,"uthmani":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","imlaei":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","simple":"قال هل انتم مطلعون","page":448,"juz":23},{"key":"37:55","surah":37,"ayah":55,"uthmani":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","imlaei":"فَاطَّلَعَ فَرَآهُ فِي سَوَاءِ الْجَحِيمِ","simple":"فاطلع فراه في سواء الجحيم","page":448,"juz":23},{"key":"37:56","surah":37,"ayah":56,"uthmani":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","imlaei":"قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ","simple":"قال تالله ان كدت لتردين","page":448,"juz":23},{"key":"37:57","surah":37,"ayah":57,"uthmani":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","imlaei":"وَلَوْلَا نِعْمَةُ رَبِّي لَكُنتُ مِنَ الْمُحْضَرِينَ","simple":"ولولا نعمة ربي لكنت من المحضرين","page":448,"juz":23},{"key":"37:58","surah":37,"ayah":58,"uthmani":"أَفَمَا نَحْنُ بِمَيِّتِينَ","imlaei":"أَفَمَا نَحْنُ بِمَيِّتِينَ","simple":"افما نحن بميتين","page":448,"juz":23},{"key":"37:59","surah":37,"ayah":59,"uthmani":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","imlaei":"إِلَّا مَوْتَتَنَا الْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","simple":"الا موتتنا الاولى وما نحن بمعذبين","page":448,"juz":23},{"key":"37:60","surah":37,"ayah":60,"uthmani":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","imlaei":"إِنَّ هَٰذَا لَهُوَ الْفَوْزُ الْعَظِيمُ","simple":"ان هذا لهو الفوز العظيم","page":448,"juz":23},{"key":"37:61","surah":37,"ayah":61,"uthmani":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ","imlaei":"لِمِثْلِ هَٰذَا فَلْيَعْمَلِ الْعَامِلُونَ","simple":"لمثل هذا فليعمل العاملون","page":448,"juz":23},{"key":"37:62","surah":37,"ayah":62,"uthmani":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","imlaei":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ الزَّقُّومِ","simple":"اذلك خير نزلا ام شجرة الزقوم","page":448,"juz":23},{"key":"37:63","surah":37,"ayah":63,"uthmani":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ","imlaei":"إِنَّا جَعَلْنَاهَا فِتْنَةً لِّلظَّالِمِينَ","simple":"انا جعلناها فتنة للظالمين","page":448,"juz":23},{"key":"37:64","surah":37,"ayah":64,"uthmani":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","imlaei":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِي أَصْلِ الْجَحِيمِ","simple":"انها شجرة تخرج في اصل الجحيم","page":448,"juz":23},{"key":"37:65","surah":37,"ayah":65,"uthmani":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ","imlaei":"طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ","simple":"طلعها كانه رءوس الشياطين","page":448,"juz":23},{"key":"37:66","surah":37,"ayah":66,"uthmani":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","imlaei":"فَإِنَّهُمْ لَآكِلُونَ مِنْهَا فَمَالِئُونَ مِنْهَا الْبُطُونَ","simple":"فانهم لاكلون منها فمالئون منها البطون","page":448,"juz":23},{"key":"37:67","surah":37,"ayah":67,"uthmani":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","imlaei":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","simple":"ثم ان لهم عليها لشوبا من حميم","page":448,"juz":23},{"key":"37:68","surah":37,"ayah":68,"uthmani":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","imlaei":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى الْجَحِيمِ","simple":"ثم ان مرجعهم لالى الجحيم","page":448,"juz":23},{"key":"37:69","surah":37,"ayah":69,"uthmani":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ","imlaei":"إِنَّهُمْ أَلْفَوْا آبَاءَهُمْ ضَالِّينَ","simple":"انهم الفوا اباءهم ضالين","page":448,"juz":23},{"key":"37:70","surah":37,"ayah":70,"uthmani":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ","imlaei":"فَهُمْ عَلَىٰ آثَارِهِمْ يُهْرَعُونَ","simple":"فهم على اثارهم يهرعون","page":448,"juz":23},{"key":"37:71","surah":37,"ayah":71,"uthmani":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","imlaei":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ","simple":"ولقد ضل قبلهم اكثر الاولين","page":448,"juz":23},{"key":"37:72","surah":37,"ayah":72,"uthmani":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","imlaei":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","simple":"ولقد ارسلنا فيهم منذرين","page":448,"juz":23},{"key":"37:73","surah":37,"ayah":73,"uthmani":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ","imlaei":"فَانظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنذَرِينَ","simple":"فانظر كيف كان عاقبة المنذرين","page":448,"juz":23},{"key":"37:74","surah":37,"ayah":74,"uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","imlaei":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ","simple":"الا عباد الله المخلصين","page":448,"juz":23},{"key":"37:75","surah":37,"ayah":75,"uthmani":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ","imlaei":"وَلَقَدْ نَادَانَا نُوحٌ فَلَنِعْمَ الْمُجِيبُونَ","simple":"ولقد نادانا نوح فلنعم المجيبون","page":448,"juz":23},{"key":"37:76","surah":37,"ayah":76,"uthmani":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","imlaei":"وَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ","simple":"ونجيناه واهله من الكرب العظيم","page":448,"juz":23},{"key":"37:77","surah":37,"ayah":77,"uthmani":"وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ","imlaei":"وَجَعَلْنَا ذُرِّيَّتَهُ هُمُ الْبَاقِينَ","simple":"وجعلنا ذريته هم الباقين","page":449,"juz":23},{"key":"37:78","surah":37,"ayah":78,"uthmani":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ","imlaei":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ","simple":"وتركنا عليه في الاخرين","page":449,"juz":23},{"key":"37:79","surah":37,"ayah":79,"uthmani":"سَلَـٰمٌ عَلَىٰ نُوحٍ فِى ٱلْعَـٰلَمِينَ","imlaei":"سَلَامٌ عَلَىٰ نُوحٍ فِي الْعَالَمِينَ","simple":"سلام على نوح في العالمين","page":449,"juz":23},{"key":"37:80","surah":37,"ayah":80,"uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","imlaei":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","simple":"انا كذلك نجزي المحسنين","page":449,"juz":23},{"key":"37:81","surah":37,"ayah":81,"uthmani":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","imlaei":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ","simple":"انه من عبادنا المؤمنين","page":449,"juz":23},{"key":"37:82","surah":37,"ayah":82,"uthmani":"ثُمَّ أَغْرَقْنَا ٱلْـَٔاخَرِينَ","imlaei":"ثُمَّ أَغْرَقْنَا الْآخَرِينَ","simple":"ثم اغرقنا الاخرين","page":449,"juz":23},{"key":"37:83","surah":37,"ayah":83,"uthmani":"۞ وَإِنَّ مِن شِيعَتِهِۦ لَإِبْرَٰهِيمَ","imlaei":"وَإِنَّ مِن شِيعَتِهِ لَإِبْرَاهِيمَ","simple":"وان من شيعته لابراهيم","page":449,"juz":23},{"key":"37:84","surah":37,"ayah":84,"uthmani":"إِذْ جَآءَ رَبَّهُۥ بِقَلْبٍ سَلِيمٍ","imlaei":"إِذْ جَاءَ رَبَّهُ بِقَلْبٍ سَلِيمٍ","simple":"اذ جاء ربه بقلب سليم","page":449,"juz":23},{"key":"37:85","surah":37,"ayah":85,"uthmani":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَ","imlaei":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَاذَا تَعْبُدُونَ","simple":"اذ قال لابيه وقومه ماذا تعبدون","page":449,"juz":23},{"key":"37:86","surah":37,"ayah":86,"uthmani":"أَئِفْكًا ءَالِهَةً دُونَ ٱللَّهِ تُرِيدُونَ","imlaei":"أَئِفْكًا آلِهَةً دُونَ اللَّهِ تُرِيدُونَ","simple":"ائفكا الهة دون الله تريدون","page":449,"juz":23},{"key":"37:87","surah":37,"ayah":87,"uthmani":"فَمَا ظَنُّكُم بِرَبِّ ٱلْعَـٰلَمِينَ","imlaei":"فَمَا ظَنُّكُم بِرَبِّ الْعَالَمِينَ","simple":"فما ظنكم برب العالمين","page":449,"juz":23},{"key":"37:88","surah":37,"ayah":88,"uthmani":"فَنَظَرَ نَظْرَةً فِى ٱلنُّجُومِ","imlaei":"فَنَظَرَ نَظْرَةً فِي النُّجُومِ","simple":"فنظر نظرة في النجوم","page":449,"juz":23},{"key":"37:89","surah":37,"ayah":89,"uthmani":"فَقَالَ إِنِّى سَقِيمٌ","imlaei":"فَقَالَ إِنِّي سَقِيمٌ","simple":"فقال اني سقيم","page":449,"juz":23},{"key":"37:90","surah":37,"ayah":90,"uthmani":"فَتَوَلَّوْا۟ عَنْهُ مُدْبِرِينَ","imlaei":"فَتَوَلَّوْا عَنْهُ مُدْبِرِينَ","simple":"فتولوا عنه مدبرين","page":449,"juz":23},{"key":"37:91","surah":37,"ayah":91,"uthmani":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ","imlaei":"فَرَاغَ إِلَىٰ آلِهَتِهِمْ فَقَالَ أَلَا تَأْكُلُونَ","simple":"فراغ الى الهتهم فقال الا تاكلون","page":449,"juz":23},{"key":"37:92","surah":37,"ayah":92,"uthmani":"مَا لَكُمْ لَا تَنطِقُونَ","imlaei":"مَا لَكُمْ لَا تَنطِقُونَ","simple":"ما لكم لا تنطقون","page":449,"juz":23},{"key":"37:93","surah":37,"ayah":93,"uthmani":"فَرَاغَ عَلَيْهِمْ ضَرْبًۢا بِٱلْيَمِينِ","imlaei":"فَرَاغَ عَلَيْهِمْ ضَرْبًا بِالْيَمِينِ","simple":"فراغ عليهم ضربا باليمين","page":449,"juz":23},{"key":"37:94","surah":37,"ayah":94,"uthmani":"فَأَقْبَلُوٓا۟ إِلَيْهِ يَزِفُّونَ","imlaei":"فَأَقْبَلُوا إِلَيْهِ يَزِفُّونَ","simple":"فاقبلوا اليه يزفون","page":449,"juz":23},{"key":"37:95","surah":37,"ayah":95,"uthmani":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ","imlaei":"قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ","simple":"قال اتعبدون ما تنحتون","page":449,"juz":23},{"key":"37:96","surah":37,"ayah":96,"uthmani":"وَٱللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ","imlaei":"وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ","simple":"والله خلقكم وما تعملون","page":449,"juz":23},{"key":"37:97","surah":37,"ayah":97,"uthmani":"قَالُوا۟ ٱبْنُوا۟ لَهُۥ بُنْيَـٰنًا فَأَلْقُوهُ فِى ٱلْجَحِيمِ","imlaei":"قَالُوا ابْنُوا لَهُ بُنْيَانًا فَأَلْقُوهُ فِي الْجَحِيمِ","simple":"قالوا ابنوا له بنيانا فالقوه في الجحيم","page":449,"juz":23},{"key":"37:98","surah":37,"ayah":98,"uthmani":"فَأَرَادُوا۟ بِهِۦ كَيْدًا فَجَعَلْنَـٰهُمُ ٱلْأَسْفَلِينَ","imlaei":"فَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَسْفَلِينَ","simple":"فارادوا به كيدا فجعلناهم الاسفلين","page":449,"juz":23},{"key":"37:99","surah":37,"ayah":99,"uthmani":"وَقَالَ إِنِّى ذَاهِبٌ إِلَىٰ رَبِّى سَيَهْدِينِ","imlaei":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهْدِينِ","simple":"وقال اني ذاهب الى ربي سيهدين","page":449,"juz":23},{"key":"37:100","surah":37,"ayah":100,"uthmani":"رَبِّ هَبْ لِى مِنَ ٱلصَّـٰلِحِينَ","imlaei":"رَبِّ هَبْ لِي مِنَ الصَّالِحِينَ","simple":"رب هب لي من الصالحين","page":449,"juz":23},{"key":"37:101","surah":37,"ayah":101,"uthmani":"فَبَشَّرْنَـٰهُ بِغُلَـٰمٍ حَلِيمٍ","imlaei":"فَبَشَّرْنَاهُ بِغُلَامٍ حَلِيمٍ","simple":"فبشرناه بغلام حليم","page":449,"juz":23},{"key":"37:102","surah":37,"ayah":102,"uthmani":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعْىَ قَالَ يَـٰبُنَىَّ إِنِّىٓ أَرَىٰ فِى ٱلْمَنَامِ أَنِّىٓ أَذْبَحُكَ فَٱنظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَـٰٓأَبَتِ ٱفْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّـٰبِرِينَ","imlaei":"فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يَا بُنَيَّ إِنِّي أَرَىٰ فِي الْمَنَامِ أَنِّي أَذْبَحُكَ فَانظُرْ مَاذَا تَرَىٰ ۚ قَالَ يَا أَبَتِ افْعَلْ مَا تُؤْمَرُ ۖ سَتَجِدُنِي إِن شَاءَ اللَّهُ مِنَ الصَّابِرِينَ","simple":"فلما بلغ معه السعي قال يا بني اني ارى في المنام اني اذبحك فانظر ماذا ترى قال يا ابت افعل ما تؤمر ستجدني ان شاء الله من الصابرين","page":449,"juz":23},{"key":"37:103","surah":37,"ayah":103,"uthmani":"فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ","imlaei":"فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ","simple":"فلما اسلما وتله للجبين","page":450,"juz":23},{"key":"37:104","surah":37,"ayah":104,"uthmani":"وَنَـٰدَيْنَـٰهُ أَن يَـٰٓإِبْرَٰهِيمُ","imlaei":"وَنَادَيْنَاهُ أَن يَا إِبْرَاهِيمُ","simple":"وناديناه ان يا ابراهيم","page":450,"juz":23},{"key":"37:105","surah":37,"ayah":105,"uthmani":"قَدْ صَدَّقْتَ ٱلرُّءْيَآ ۚ إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","imlaei":"قَدْ صَدَّقْتَ الرُّؤْيَا ۚ إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","simple":"قد صدقت الرؤيا انا كذلك نجزي المحسنين","page":450,"juz":23},{"key":"37:106","surah":37,"ayah":106,"uthmani":"إِنَّ هَـٰذَا لَهُوَ ٱلْبَلَـٰٓؤُا۟ ٱلْمُبِينُ","imlaei":"إِنَّ هَٰذَا لَهُوَ الْبَلَاءُ الْمُبِينُ","simple":"ان هذا لهو البلاء المبين","page":450,"juz":23},{"key":"37:107","surah":37,"ayah":107,"uthmani":"وَفَدَيْنَـٰهُ بِذِبْحٍ عَظِيمٍ","imlaei":"وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ","simple":"وفديناه بذبح عظيم","page":450,"juz":23},{"key":"37:108","surah":37,"ayah":108,"uthmani":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ","imlaei":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ","simple":"وتركنا عليه في الاخرين","page":450,"juz":23},{"key":"37:109","surah":37,"ayah":109,"uthmani":"سَلَـٰمٌ عَلَىٰٓ إِبْرَٰهِيمَ","imlaei":"سَلَامٌ عَلَىٰ إِبْرَاهِيمَ","simple":"سلام على ابراهيم","page":450,"juz":23},{"key":"37:110","surah":37,"ayah":110,"uthmani":"كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","imlaei":"كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","simple":"كذلك نجزي المحسنين","page":450,"juz":23},{"key":"37:111","surah":37,"ayah":111,"uthmani":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","imlaei":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ","simple":"انه من عبادنا المؤمنين","page":450,"juz":23},{"key":"37:112","surah":37,"ayah":112,"uthmani":"وَبَشَّرْنَـٰهُ بِإِسْحَـٰقَ نَبِيًّا مِّنَ ٱلصَّـٰلِحِينَ","imlaei":"وَبَشَّرْنَاهُ بِإِسْحَاقَ نَبِيًّا مِّنَ الصَّالِحِينَ","simple":"وبشرناه باسحاق نبيا من الصالحين","page":450,"juz":23},{"key":"37:113","surah":37,"ayah":113,"uthmani":"وَبَـٰرَكْنَا عَلَيْهِ وَعَلَىٰٓ إِسْحَـٰقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِۦ مُبِينٌ","imlaei":"وَبَارَكْنَا عَلَيْهِ وَعَلَىٰ إِسْحَاقَ ۚ وَمِن ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِّنَفْسِهِ مُبِينٌ","simple":"وباركنا عليه وعلى اسحاق ومن ذريتهما محسن وظالم لنفسه مبين","page":450,"juz":23},{"key":"37:114","surah":37,"ayah":114,"uthmani":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَـٰرُونَ","imlaei":"وَلَقَدْ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَارُونَ","simple":"ولقد مننا على موسى وهارون","page":450,"juz":23},{"key":"37:115","surah":37,"ayah":115,"uthmani":"وَنَجَّيْنَـٰهُمَا وَقَوْمَهُمَا مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","imlaei":"وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيمِ","simple":"ونجيناهما وقومهما من الكرب العظيم","page":450,"juz":23},{"key":"37:116","surah":37,"ayah":116,"uthmani":"وَنَصَرْنَـٰهُمْ فَكَانُوا۟ هُمُ ٱلْغَـٰلِبِينَ","imlaei":"وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِبِينَ","simple":"ونصرناهم فكانوا هم الغالبين","page":450,"juz":23},{"key":"37:117","surah":37,"ayah":117,"uthmani":"وَءَاتَيْنَـٰهُمَا ٱلْكِتَـٰبَ ٱلْمُسْتَبِينَ","imlaei":"وَآتَيْنَاهُمَا الْكِتَابَ الْمُسْتَبِينَ","simple":"واتيناهما الكتاب المستبين","page":450,"juz":23},{"key":"37:118","surah":37,"ayah":118,"uthmani":"وَهَدَيْنَـٰهُمَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ","imlaei":"وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَقِيمَ","simple":"وهديناهما الصراط المستقيم","page":450,"juz":23},{"key":"37:119","surah":37,"ayah":119,"uthmani":"وَتَرَكْنَا عَلَيْهِمَا فِى ٱلْـَٔاخِرِينَ","imlaei":"وَتَرَكْنَا عَلَيْهِمَا فِي الْآخِرِينَ","simple":"وتركنا عليهما في الاخرين","page":450,"juz":23},{"key":"37:120","surah":37,"ayah":120,"uthmani":"سَلَـٰمٌ عَلَىٰ مُوسَىٰ وَهَـٰرُونَ","imlaei":"سَلَامٌ عَلَىٰ مُوسَىٰ وَهَارُونَ","simple":"سلام على موسى وهارون","page":450,"juz":23},{"key":"37:121","surah":37,"ayah":121,"uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","imlaei":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","simple":"انا كذلك نجزي المحسنين","page":450,"juz":23},{"key":"37:122","surah":37,"ayah":122,"uthmani":"إِنَّهُمَا مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","imlaei":"إِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِنِينَ","simple":"انهما من عبادنا المؤمنين","page":450,"juz":23},{"key":"37:123","surah":37,"ayah":123,"uthmani":"وَإِنَّ إِلْيَاسَ لَمِنَ ٱلْمُرْسَلِينَ","imlaei":"وَإِنَّ إِلْيَاسَ لَمِنَ الْمُرْسَلِينَ","simple":"وان الياس لمن المرسلين","page":450,"juz":23},{"key":"37:124","surah":37,"ayah":124,"uthmani":"إِذْ قَالَ لِقَوْمِهِۦٓ أَلَا تَتَّقُونَ","imlaei":"إِذْ قَالَ لِقَوْمِهِ أَلَا تَتَّقُونَ","simple":"اذ قال لقومه الا تتقون","page":450,"juz":23},{"key":"37:125","surah":37,"ayah":125,"uthmani":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ ٱلْخَـٰلِقِينَ","imlaei":"أَتَدْعُونَ بَعْلًا وَتَذَرُونَ أَحْسَنَ الْخَالِقِينَ","simple":"اتدعون بعلا وتذرون احسن الخالقين","page":450,"juz":23},{"key":"37:126","surah":37,"ayah":126,"uthmani":"ٱللَّهَ رَبَّكُمْ وَرَبَّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","imlaei":"اللَّهَ رَبَّكُمْ وَرَبَّ آبَائِكُمُ الْأَوَّلِينَ","simple":"الله ربكم ورب ابائكم الاولين","page":450,"juz":23},{"key":"37:127","surah":37,"ayah":127,"uthmani":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ","imlaei":"فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ","simple":"فكذبوه فانهم لمحضرون","page":451,"juz":23},{"key":"37:128","surah":37,"ayah":128,"uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","imlaei":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ","simple":"الا عباد الله المخلصين","page":451,"juz":23},{"key":"37:129","surah":37,"ayah":129,"uthmani":"وَتَرَكْنَا عَلَيْهِ فِى ٱلْـَٔاخِرِينَ","imlaei":"وَتَرَكْنَا عَلَيْهِ فِي الْآخِرِينَ","simple":"وتركنا عليه في الاخرين","page":451,"juz":23},{"key":"37:130","surah":37,"ayah":130,"uthmani":"سَلَـٰمٌ عَلَىٰٓ إِلْ يَاسِينَ","imlaei":"سَلَامٌ عَلَىٰ إِلْ يَاسِينَ","simple":"سلام على ال ياسين","page":451,"juz":23},{"key":"37:131","surah":37,"ayah":131,"uthmani":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","imlaei":"إِنَّا كَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","simple":"انا كذلك نجزي المحسنين","page":451,"juz":23},{"key":"37:132","surah":37,"ayah":132,"uthmani":"إِنَّهُۥ مِنْ عِبَادِنَا ٱلْمُؤْمِنِينَ","imlaei":"إِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِنِينَ","simple":"انه من عبادنا المؤمنين","page":451,"juz":23},{"key":"37:133","surah":37,"ayah":133,"uthmani":"وَإِنَّ لُوطًا لَّمِنَ ٱلْمُرْسَلِينَ","imlaei":"وَإِنَّ لُوطًا لَّمِنَ الْمُرْسَلِينَ","simple":"وان لوطا لمن المرسلين","page":451,"juz":23},{"key":"37:134","surah":37,"ayah":134,"uthmani":"إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ","imlaei":"إِذْ نَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ","simple":"اذ نجيناه واهله اجمعين","page":451,"juz":23},{"key":"37:135","surah":37,"ayah":135,"uthmani":"إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ","imlaei":"إِلَّا عَجُوزًا فِي الْغَابِرِينَ","simple":"الا عجوزا في الغابرين","page":451,"juz":23},{"key":"37:136","surah":37,"ayah":136,"uthmani":"ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ","imlaei":"ثُمَّ دَمَّرْنَا الْآخَرِينَ","simple":"ثم دمرنا الاخرين","page":451,"juz":23},{"key":"37:137","surah":37,"ayah":137,"uthmani":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ","imlaei":"وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ","simple":"وانكم لتمرون عليهم مصبحين","page":451,"juz":23},{"key":"37:138","surah":37,"ayah":138,"uthmani":"وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ","imlaei":"وَبِاللَّيْلِ ۗ أَفَلَا تَعْقِلُونَ","simple":"وبالليل افلا تعقلون","page":451,"juz":23},{"key":"37:139","surah":37,"ayah":139,"uthmani":"وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ","imlaei":"وَإِنَّ يُونُسَ لَمِنَ الْمُرْسَلِينَ","simple":"وان يونس لمن المرسلين","page":451,"juz":23},{"key":"37:140","surah":37,"ayah":140,"uthmani":"إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ","imlaei":"إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ","simple":"اذ ابق الى الفلك المشحون","page":451,"juz":23},{"key":"37:141","surah":37,"ayah":141,"uthmani":"فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ","imlaei":"فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضِينَ","simple":"فساهم فكان من المدحضين","page":451,"juz":23},{"key":"37:142","surah":37,"ayah":142,"uthmani":"فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ","imlaei":"فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلِيمٌ","simple":"فالتقمه الحوت وهو مليم","page":451,"juz":23},{"key":"37:143","surah":37,"ayah":143,"uthmani":"فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ","imlaei":"فَلَوْلَا أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ","simple":"فلولا انه كان من المسبحين","page":451,"juz":23},{"key":"37:144","surah":37,"ayah":144,"uthmani":"لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ","imlaei":"لَلَبِثَ فِي بَطْنِهِ إِلَىٰ يَوْمِ يُبْعَثُونَ","simple":"للبث في بطنه الى يوم يبعثون","page":451,"juz":23},{"key":"37:145","surah":37,"ayah":145,"uthmani":"۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ","imlaei":"فَنَبَذْنَاهُ بِالْعَرَاءِ وَهُوَ سَقِيمٌ","simple":"فنبذناه بالعراء وهو سقيم","page":451,"juz":23},{"key":"37:146","surah":37,"ayah":146,"uthmani":"وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ","imlaei":"وَأَنبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ","simple":"وانبتنا عليه شجرة من يقطين","page":451,"juz":23},{"key":"37:147","surah":37,"ayah":147,"uthmani":"وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ","imlaei":"وَأَرْسَلْنَاهُ إِلَىٰ مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ","simple":"وارسلناه الى مائة الف او يزيدون","page":451,"juz":23},{"key":"37:148","surah":37,"ayah":148,"uthmani":"فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ","imlaei":"فَآمَنُوا فَمَتَّعْنَاهُمْ إِلَىٰ حِينٍ","simple":"فامنوا فمتعناهم الى حين","page":451,"juz":23},{"key":"37:149","surah":37,"ayah":149,"uthmani":"فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ","imlaei":"فَاسْتَفْتِهِمْ أَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَ","simple":"فاستفتهم الربك البنات ولهم البنون","page":451,"juz":23},{"key":"37:150","surah":37,"ayah":150,"uthmani":"أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ","imlaei":"أَمْ خَلَقْنَا الْمَلَائِكَةَ إِنَاثًا وَهُمْ شَاهِدُونَ","simple":"ام خلقنا الملائكة اناثا وهم شاهدون","page":451,"juz":23},{"key":"37:151","surah":37,"ayah":151,"uthmani":"أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ","imlaei":"أَلَا إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ","simple":"الا انهم من افكهم ليقولون","page":451,"juz":23},{"key":"37:152","surah":37,"ayah":152,"uthmani":"وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ","imlaei":"وَلَدَ اللَّهُ وَإِنَّهُمْ لَكَاذِبُونَ","simple":"ولد الله وانهم لكاذبون","page":451,"juz":23},{"key":"37:153","surah":37,"ayah":153,"uthmani":"أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ","imlaei":"أَصْطَفَى الْبَنَاتِ عَلَى الْبَنِينَ","simple":"اصطفى البنات على البنين","page":451,"juz":23},{"key":"37:154","surah":37,"ayah":154,"uthmani":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","imlaei":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","simple":"ما لكم كيف تحكمون","page":452,"juz":23},{"key":"37:155","surah":37,"ayah":155,"uthmani":"أَفَلَا تَذَكَّرُونَ","imlaei":"أَفَلَا تَذَكَّرُونَ","simple":"افلا تذكرون","page":452,"juz":23},{"key":"37:156","surah":37,"ayah":156,"uthmani":"أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ","imlaei":"أَمْ لَكُمْ سُلْطَانٌ مُّبِينٌ","simple":"ام لكم سلطان مبين","page":452,"juz":23},{"key":"37:157","surah":37,"ayah":157,"uthmani":"فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ","imlaei":"فَأْتُوا بِكِتَابِكُمْ إِن كُنتُمْ صَادِقِينَ","simple":"فاتوا بكتابكم ان كنتم صادقين","page":452,"juz":23},{"key":"37:158","surah":37,"ayah":158,"uthmani":"وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ","imlaei":"وَجَعَلُوا بَيْنَهُ وَبَيْنَ الْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ الْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ","simple":"وجعلوا بينه وبين الجنة نسبا ولقد علمت الجنة انهم لمحضرون","page":452,"juz":23},{"key":"37:159","surah":37,"ayah":159,"uthmani":"سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","imlaei":"سُبْحَانَ اللَّهِ عَمَّا يَصِفُونَ","simple":"سبحان الله عما يصفون","page":452,"juz":23},{"key":"37:160","surah":37,"ayah":160,"uthmani":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","imlaei":"إِلَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ","simple":"الا عباد الله المخلصين","page":452,"juz":23},{"key":"37:161","surah":37,"ayah":161,"uthmani":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ","imlaei":"فَإِنَّكُمْ وَمَا تَعْبُدُونَ","simple":"فانكم وما تعبدون","page":452,"juz":23},{"key":"37:162","surah":37,"ayah":162,"uthmani":"مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ","imlaei":"مَا أَنتُمْ عَلَيْهِ بِفَاتِنِينَ","simple":"ما انتم عليه بفاتنين","page":452,"juz":23},{"key":"37:163","surah":37,"ayah":163,"uthmani":"إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ","imlaei":"إِلَّا مَنْ هُوَ صَالِ الْجَحِيمِ","simple":"الا من هو صال الجحيم","page":452,"juz":23},{"key":"37:164","surah":37,"ayah":164,"uthmani":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ","imlaei":"وَمَا مِنَّا إِلَّا لَهُ مَقَامٌ مَّعْلُومٌ","simple":"وما منا الا له مقام معلوم","page":452,"juz":23},{"key":"37:165","surah":37,"ayah":165,"uthmani":"وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ","imlaei":"وَإِنَّا لَنَحْنُ الصَّافُّونَ","simple":"وانا لنحن الصافون","page":452,"juz":23},{"key":"37:166","surah":37,"ayah":166,"uthmani":"وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ","imlaei":"وَإِنَّا لَنَحْنُ الْمُسَبِّحُونَ","simple":"وانا لنحن المسبحون","page":452,"juz":23},{"key":"37:167","surah":37,"ayah":167,"uthmani":"وَإِن كَانُوا۟ لَيَقُولُونَ","imlaei":"وَإِن كَانُوا لَيَقُولُونَ","simple":"وان كانوا ليقولون","page":452,"juz":23},{"key":"37:168","surah":37,"ayah":168,"uthmani":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ","imlaei":"لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ الْأَوَّلِينَ","simple":"لو ان عندنا ذكرا من الاولين","page":452,"juz":23},{"key":"37:169","surah":37,"ayah":169,"uthmani":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","imlaei":"لَكُنَّا عِبَادَ اللَّهِ الْمُخْلَصِينَ","simple":"لكنا عباد الله المخلصين","page":452,"juz":23},{"key":"37:170","surah":37,"ayah":170,"uthmani":"فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ","imlaei":"فَكَفَرُوا بِهِ ۖ فَسَوْفَ يَعْلَمُونَ","simple":"فكفروا به فسوف يعلمون","page":452,"juz":23},{"key":"37:171","surah":37,"ayah":171,"uthmani":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ","imlaei":"وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِينَ","simple":"ولقد سبقت كلمتنا لعبادنا المرسلين","page":452,"juz":23},{"key":"37:172","surah":37,"ayah":172,"uthmani":"إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ","imlaei":"إِنَّهُمْ لَهُمُ الْمَنصُورُونَ","simple":"انهم لهم المنصورون","page":452,"juz":23},{"key":"37:173","surah":37,"ayah":173,"uthmani":"وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ","imlaei":"وَإِنَّ جُندَنَا لَهُمُ الْغَالِبُونَ","simple":"وان جندنا لهم الغالبون","page":452,"juz":23},{"key":"37:174","surah":37,"ayah":174,"uthmani":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","imlaei":"فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","simple":"فتول عنهم حتى حين","page":452,"juz":23},{"key":"37:175","surah":37,"ayah":175,"uthmani":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","imlaei":"وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ","simple":"وابصرهم فسوف يبصرون","page":452,"juz":23},{"key":"37:176","surah":37,"ayah":176,"uthmani":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","imlaei":"أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ","simple":"افبعذابنا يستعجلون","page":452,"juz":23},{"key":"37:177","surah":37,"ayah":177,"uthmani":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ","imlaei":"فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَاءَ صَبَاحُ الْمُنذَرِينَ","simple":"فاذا نزل بساحتهم فساء صباح المنذرين","page":452,"juz":23},{"key":"37:178","surah":37,"ayah":178,"uthmani":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","imlaei":"وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ","simple":"وتول عنهم حتى حين","page":452,"juz":23},{"key":"37:179","surah":37,"ayah":179,"uthmani":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","imlaei":"وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ","simple":"وابصر فسوف يبصرون","page":452,"juz":23},{"key":"37:180","surah":37,"ayah":180,"uthmani":"سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ","imlaei":"سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَ","simple":"سبحان ربك رب العزة عما يصفون","page":452,"juz":23},{"key":"37:181","surah":37,"ayah":181,"uthmani":"وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ","imlaei":"وَسَلَامٌ عَلَى الْمُرْسَلِينَ","simple":"وسلام على المرسلين","page":452,"juz":23},{"key":"37:182","surah":37,"ayah":182,"uthmani":"وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ","imlaei":"وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","simple":"والحمد لله رب العالمين","page":452,"juz":23}]}
