laei":"حَدَائِقَ وَأَعْنَابًا","simple":"حدائق واعنابا","page":583,"juz":30},{"key":"78:33","surah":78,"ayah":33,"uthmani":"وَكَوَاعِبَ أَتْرَابًا","imlaei":"وَكَوَاعِبَ أَتْرَابًا","simple":"وكواعب اترابا","page":583,"juz":30},{"key":"78:34","surah":78,"ayah":34,"uthmani":"وَكَأْسًا دِهَاقًا","imlaei":"وَكَأْسًا دِهَاقًا","simple":"وكاسا دهاقا","page":583,"juz":30},{"key":"78:35","surah":78,"ayah":35,"uthmani":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا","imlaei":"لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّابًا","simple":"لا يسمعون فيها لغوا ولا كذابا","page":583,"juz":30},{"key":"78:36","surah":78,"ayah":36,"uthmani":"جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا","imlaei":"جَزَاءً مِّن رَّبِّكَ عَطَاءً حِسَابًا","simple":"جزاء من ربك عطاء حسابا","page":583,"juz":30},{"key":"78:37","surah":78,"ayah":37,"uthmani":"رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","imlaei":"رَّبِّ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا الرَّحْمَٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا","simple":"رب السماوات والارض وما بينهما الرحمن لا يملكون منه خطابا","page":583,"juz":30},{"key":"78:38","surah":78,"ayah":38,"uthmani":"يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا","imlaei":"يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَٰنُ وَقَالَ صَوَابًا","simple":"يوم يقوم الروح والملائكة صفا لا يتكلمون الا من اذن له الرحمن وقال صوابا","page":583,"juz":30},{"key":"78:39","surah":78,"ayah":39,"uthmani":"ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","imlaei":"ذَٰلِكَ الْيَوْمُ الْحَقُّ ۖ فَمَن شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ مَآبًا","simple":"ذلك اليوم الحق فمن شاء اتخذ الى ربه مابا","page":583,"juz":30},{"key":"78:40","surah":78,"ayah":40,"uthmani":"إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا","imlaei":"إِنَّا أَنذَرْنَاكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَنِي كُنتُ تُرَابًا","simple":"انا انذرناكم عذابا قريبا يوم ينظر المرء ما قدمت يداه ويقول الكافر يا ليتني كنت ترابا","page":583,"juz":30}]}
