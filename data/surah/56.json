ِنَ ٱلْحَمِيمِ","imlaei":"فَشَارِبُونَ عَلَيْهِ مِنَ الْحَمِيمِ","simple":"فشاربون عليه من الحميم","page":536,"juz":27},{"key":"56:55","surah":56,"ayah":55,"uthmani":"فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ","imlaei":"فَشَارِبُونَ شُرْبَ الْهِيمِ","simple":"فشاربون شرب الهيم","page":536,"juz":27},{"key":"56:56","surah":56,"ayah":56,"uthmani":"هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ","imlaei":"هَٰذَا نُزُلُهُمْ يَوْمَ الدِّينِ","simple":"هذا نزلهم يوم الدين","page":536,"juz":27},{"key":"56:57","surah":56,"ayah":57,"uthmani":"نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ","imlaei":"نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ","simple":"نحن خلقناكم فلولا تصدقون","page":536,"juz":27},{"key":"56:58","surah":56,"ayah":58,"uthmani":"أَفَرَءَيْتُم مَّا تُمْنُونَ","imlaei":"أَفَرَأَيْتُم مَّا تُمْنُونَ","simple":"افرايتم ما تمنون","page":536,"juz":27},{"key":"56:59","surah":56,"ayah":59,"uthmani":"ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ","imlaei":"أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ","simple":"اانتم تخلقونه ام نحن الخالقون","page":536,"juz":27},{"key":"56:60","surah":56,"ayah":60,"uthmani":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","imlaei":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ","simple":"نحن قدرنا بينكم الموت وما نحن بمسبوقين","page":536,"juz":27},{"key":"56:61","surah":56,"ayah":61,"uthmani":"عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ","imlaei":"عَلَىٰ أَن نُّبَدِّلَ أَمْثَالَكُمْ وَنُنشِئَكُمْ فِي مَا لَا تَعْلَمُونَ","simple":"على ان نبدل امثالكم وننشئكم في ما لا تعلمون","page":536,"juz":27},{"key":"56:62","surah":56,"ayah":62,"uthmani":"وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","imlaei":"وَلَقَدْ عَلِمْتُمُ النَّشْأَةَ الْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ","simple":"ولقد علمتم النشاة الاولى فلولا تذكرون","page":536,"juz":27},{"key":"56:63","surah":56,"ayah":63,"uthmani":"أَفَرَءَيْتُم مَّا تَحْرُثُونَ","imlaei":"أَفَرَأَيْتُم مَّا تَحْرُثُونَ","simple":"افرايتم ما تحرثون","page":536,"juz":27},{"key":"56:64","surah":56,"ayah":64,"uthmani":"ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ","imlaei":"أَأَنتُمْ تَزْرَعُونَهُ أَمْ نَحْنُ الزَّارِعُونَ","simple":"اانتم تزرعونه ام نحن الزارعون","page":536,"juz":27},{"key":"56:65","surah":56,"ayah":65,"uthmani":"لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ","imlaei":"لَوْ نَشَاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ","simple":"لو نشاء لجعلناه حطاما فظلتم تفكهون","page":536,"juz":27},{"key":"56:66","surah":56,"ayah":66,"uthmani":"إِنَّا لَمُغْرَمُونَ","imlaei":"إِنَّا لَمُغْرَمُونَ","simple":"انا لمغرمون","page":536,"juz":27},{"key":"56:67","surah":56,"ayah":67,"uthmani":"بَلْ نَحْنُ مَحْرُومُونَ","imlaei":"بَلْ نَحْنُ مَحْرُومُونَ","simple":"بل نحن محرومون","page":536,"juz":27},{"key":"56:68","surah":56,"ayah":68,"uthmani":"أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ","imlaei":"أَفَرَأَيْتُمُ الْمَاءَ الَّذِي تَشْرَبُونَ","simple":"افرايتم الماء الذي تشربون","page":536,"juz":27},{"key":"56:69","surah":56,"ayah":69,"uthmani":"ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ","imlaei":"أَأَنتُمْ أَنزَلْتُمُوهُ مِنَ الْمُزْنِ أَمْ نَحْنُ الْمُنزِلُونَ","simple":"اانتم انزلتموه من المزن ام نحن المنزلون","page":536,"juz":27},{"key":"56:70","surah":56,"ayah":70,"uthmani":"لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","imlaei":"لَوْ نَشَاءُ جَعَلْنَاهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ","simple":"لو نشاء جعلناه اجاجا فلولا تشكرون","page":536,"juz":27},{"key":"56:71","surah":56,"ayah":71,"uthmani":"أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ","imlaei":"أَفَرَأَيْتُمُ النَّارَ الَّتِي تُورُونَ","simple":"افرايتم النار التي تورون","page":536,"juz":27},{"key":"56:72","surah":56,"ayah":72,"uthmani":"ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ","imlaei":"أَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَا أَمْ نَحْنُ الْمُنشِئُونَ","simple":"اانتم انشاتم شجرتها ام نحن المنشئون","page":536,"juz":27},{"key":"56:73","surah":56,"ayah":73,"uthmani":"نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ","imlaei":"نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِّلْمُقْوِينَ","simple":"نحن جعلناها تذكرة ومتاعا للمقوين","page":536,"juz":27},{"key":"56:74","surah":56,"ayah":74,"uthmani":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ","imlaei":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","simple":"فسبح باسم ربك العظيم","page":536,"juz":27},{"key":"56:75","surah":56,"ayah":75,"uthmani":"۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ","imlaei":"فَلَا أُقْسِمُ بِمَوَاقِعِ النُّجُومِ","simple":"فلا اقسم بمواقع النجوم","page":536,"juz":27},{"key":"56:76","surah":56,"ayah":76,"uthmani":"وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ","imlaei":"وَإِنَّهُ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ","simple":"وانه لقسم لو تعلمون عظيم","page":536,"juz":27},{"key":"56:77","surah":56,"ayah":77,"uthmani":"إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ","imlaei":"إِنَّهُ لَقُرْآنٌ كَرِيمٌ","simple":"انه لقران كريم","page":537,"juz":27},{"key":"56:78","surah":56,"ayah":78,"uthmani":"فِى كِتَـٰبٍ مَّكْنُونٍ","imlaei":"فِي كِتَابٍ مَّكْنُونٍ","simple":"في كتاب مكنون","page":537,"juz":27},{"key":"56:79","surah":56,"ayah":79,"uthmani":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ","imlaei":"لَّا يَمَسُّهُ إِلَّا الْمُطَهَّرُونَ","simple":"لا يمسه الا المطهرون","page":537,"juz":27},{"key":"56:80","surah":56,"ayah":80,"uthmani":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ","imlaei":"تَنزِيلٌ مِّن رَّبِّ الْعَالَمِينَ","simple":"تنزيل من رب العالمين","page":537,"juz":27},{"key":"56:81","surah":56,"ayah":81,"uthmani":"أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ","imlaei":"أَفَبِهَٰذَا الْحَدِيثِ أَنتُم مُّدْهِنُونَ","simple":"افبهذا الحديث انتم مدهنون","page":537,"juz":27},{"key":"56:82","surah":56,"ayah":82,"uthmani":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","imlaei":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ","simple":"وتجعلون رزقكم انكم تكذبون","page":537,"juz":27},{"key":"56:83","surah":56,"ayah":83,"uthmani":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ","imlaei":"فَلَوْلَا إِذَا بَلَغَتِ الْحُلْقُومَ","simple":"فلولا اذا بلغت الحلقوم","page":537,"juz":27},{"key":"56:84","surah":56,"ayah":84,"uthmani":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ","imlaei":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ","simple":"وانتم حينئذ تنظرون","page":537,"juz":27},{"key":"56:85","surah":56,"ayah":85,"uthmani":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ","imlaei":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ","simple":"ونحن اقرب اليه منكم ولكن لا تبصرون","page":537,"juz":27},{"key":"56:86","surah":56,"ayah":86,"uthmani":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ","imlaei":"فَلَوْلَا إِن كُنتُمْ غَيْرَ مَدِينِينَ","simple":"فلولا ان كنتم غير مدينين","page":537,"juz":27},{"key":"56:87","surah":56,"ayah":87,"uthmani":"تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ","imlaei":"تَرْجِعُونَهَا إِن كُنتُمْ صَادِقِينَ","simple":"ترجعونها ان كنتم صادقين","page":537,"juz":27},{"key":"56:88","surah":56,"ayah":88,"uthmani":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ","imlaei":"فَأَمَّا إِن كَانَ مِنَ الْمُقَرَّبِينَ","simple":"فاما ان كان من المقربين","page":537,"juz":27},{"key":"56:89","surah":56,"ayah":89,"uthmani":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ","imlaei":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ","simple":"فروح وريحان وجنت نعيم","page":537,"juz":27},{"key":"56:90","surah":56,"ayah":90,"uthmani":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","imlaei":"وَأَمَّا إِن كَانَ مِنْ أَصْحَابِ الْيَمِينِ","simple":"واما ان كان من اصحاب اليمين","page":537,"juz":27},{"key":"56:91","surah":56,"ayah":91,"uthmani":"فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ","imlaei":"فَسَلَامٌ لَّكَ مِنْ أَصْحَابِ الْيَمِينِ","simple":"فسلام لك من اصحاب اليمين","page":537,"juz":27},{"key":"56:92","surah":56,"ayah":92,"uthmani":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ","imlaei":"وَأَمَّا إِن كَانَ مِنَ الْمُكَذِّبِينَ الضَّالِّينَ","simple":"واما ان كان من المكذبين الضالين","page":537,"juz":27},{"key":"56:93","surah":56,"ayah":93,"uthmani":"فَنُزُلٌ مِّنْ حَ